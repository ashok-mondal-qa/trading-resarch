# Copy to .env (git-ignored). Put SECRETS in ./secrets/<name> files, not here (see docker-compose.yml).
# Never paste any of these values into chat, Telegram, an issue or a commit.

# --- Mode ------------------------------------------------------------------------------------------------
# PAPER (default) or LIVE_APPROVAL (refuses to start unless the live gate passes)
EXECUTION_MODE=PAPER
# true = no new entries at all
KILL_SWITCH=false

# --- Telegram approval gateway (required in every mode) ----------------------------------------------------
# your private chat id with the bot (an integer)
TELEGRAM_ALLOWED_CHAT_ID=
# your Telegram user id (comma-separated if more than one approver)
TELEGRAM_ALLOWED_USER_IDS=
# approval buttons expire after this (max 300)
APPROVAL_TTL_SEC=90
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token   (set by docker-compose)

# --- Risk (can be tightened, never loosened past the hard limits) ------------------------------------------
# hard ceiling 300, includes slippage and charges
MAX_PLANNED_RISK_INR=300
# hard floor 2 (net of costs)
MIN_REWARD_RISK=2
# cash cap per trade: no leverage
MAX_NOTIONAL_INR=15000
MAX_QUOTE_AGE_SEC=60
ENTRY_WINDOW_START=09:20
ENTRY_WINDOW_END=14:30
# you get an exit-approval request for open intraday positions
SQUARE_OFF_TIME=15:05
# project policy bans derivatives; keep false
ALLOW_DERIVATIVES=false
ALLOW_SHORT=false
MAX_ENTRY_DEVIATION_PCT=1.0
SLIPPAGE_BPS_ENTRY=5
SLIPPAGE_BPS_STOP=10
# charge rates are unverified; keep a buffer until checked against a contract note
CHARGES_SAFETY_BUFFER_PCT=25
# comma-separated YYYY-MM-DD from NSE's holiday list
NSE_HOLIDAYS=

# --- OCO protection ---------------------------------------------------------------------------------------
OCO_MAX_ATTEMPTS=3
OCO_CONFIRM_TIMEOUT_SEC=30
RECONCILE_INTERVAL_MS=3000

# --- Groww (read-only quotes in PAPER; orders only in LIVE_APPROVAL after the gate) --------------------------
GROWW_BASE_URL=https://api.groww.in/v1
GROWW_TIMEOUT_MS=8000
# GROWW_API_KEY_FILE / GROWW_API_SECRET_FILE are set by docker-compose. Alternatives:
# GROWW_TOTP_SEED_FILE=...      (TOTP-type API key instead of the secret)
# GROWW_ACCESS_TOKEN_FILE=...   (a token you generated for the day)

# --- Live gate (all must pass; see docs/ARCHITECTURE.md) ----------------------------------------------------
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=
# must be ACCEPTED in experiments/registry.csv (none is today)
LIVE_STRATEGY_IDS=
SAFETY_ATTESTATION_PATH=safety-attestation.json
SAFETY_ATTESTATION_MAX_AGE_DAYS=7
# hard floor 20
LIVE_MIN_PAPER_WORKFLOWS=20

# --- Intake (where the research scan posts proposals) --------------------------------------------------------
INTAKE_PORT=8787
# INTAKE_TOKEN_FILE=/run/secrets/intake_token   (set by docker-compose)
