{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_live_orders.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "upstox-mcp@upstox-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "upstox-plugins-official": {
      "source": {
        "source": "github",
        "repo": "upstox/upstox-plugin-marketplace"
      }
    }
  }
}
